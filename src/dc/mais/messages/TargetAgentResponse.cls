Class dc.mais.messages.TargetAgentResponse Extends Ens.Response
{

/// The textual response generated by the Agent (System Prompt or Final Response)
Property Content As %String(MAXLEN = "");

/// The list of tools available to this agent (JSON string)
/// This is vital for the Engine to know what to pass to the LLM
Property Tools As %String(MAXLEN = "");

Storage Default
{
<Data name="TargetAgentResponseDefaultData">
<Subscript>"TargetAgentResponse"</Subscript>
<Value name="1">
<Value>Content</Value>
</Value>
<Value name="2">
<Value>Tools</Value>
</Value>
</Data>
<DefaultData>TargetAgentResponseDefaultData</DefaultData>
<Type>%Storage.Persistent</Type>
}

}
